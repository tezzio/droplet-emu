<component type="desktop-application">
  <id>dev.eden_emu.eden</id>
  <metadata_license>CC0-1.0</metadata_license>
  <name>Droplet</name>
  <summary>Nintendo Switch 2 emulator</summary>
  <description>
    <p>Droplet is an experimental Nintendo Switch 2 emulator for Linux and Windows. It is a modified version of eden-nx2, which brings Switch 2 support to the Eden emulator.</p>
  </description>
  <categories>
    <category>Game</category>
    <category>Emulator</category>
  </categories>
  <keywords>
    <keyword>switch</keyword>
    <keyword>emulator</keyword>
  </keywords>
  <url type="homepage">https://gitlab.com/seighttt/droplet</url>
  <url type="bugtracker">https://gitlab.com/seighttt/droplet/-/issues</url>
  <url type="help">https://gitlab.com/seighttt/droplet/-/blob/main/README.md</url>
  <url type="vcs-browser">https://gitlab.com/seighttt/droplet</url>
  <url type="contribute">https://gitlab.com/seighttt/droplet/-/blob/main/CONTRIBUTING.md</url>
  <launchable type="desktop-id">dev.eden_emu.eden.desktop</launchable>
  <provides>
    <binary>yuzu</binary>
    <binary>yuzu-cmd</binary>
  </provides>
  <supports>
    <control>pointing</control>
    <control>keyboard</control>
    <control>gamepad</control>
    <internet>offline-only</internet>
  </supports>
  <requires>
    <memory>8192</memory>
  </requires>
  <recommends>
    <memory>16384</memory>
  </recommends>
  <project_license>GPL-3.0-or-later</project_license>
  <content_rating type="oars-1.0"/>
</component>
